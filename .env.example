# Database & Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Speech-to-Text API
SONIOX_API_KEY=your_soniox_api_key

# Internal App Secrets
PAYLINGO_MOBILE_SECRET=your_paylingo_mobile_secret
ADMIN_SESSION_SECRET=generate_a_random_secret_at_least_32_bytes
ADMIN_BOOTSTRAP_PASSWORD=set_only_for_initial_admin_setup
NEXT_PUBLIC_APP_URL=https://noidi.9phut.org
PASSKEY_RP_ID=noidi.9phut.org
PASSKEY_ORIGIN=https://noidi.9phut.org
AI_ALLOWED_HOSTS=api.openai.com

# SMTP Email Configuration
SMTP_HOST=smtp.your-company.com
SMTP_PORT=587
SMTP_USER=no-reply@your-company.com
SMTP_PASS=your_smtp_password
MAIL_FROM="Paypay - Pay Linggo <no-reply@your-company.com>"
