# Speech-to-Text API
SONIOX_API_KEY=your_soniox_api_key

# Google OAuth 2.0 SSO
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Internal App & Admin Secrets
ADMIN_SESSION_SECRET=generate_a_random_secret_at_least_32_bytes
AI_KEY_ENCRYPTION_SECRET=generate_a_random_secret_at_least_32_bytes
ADMIN_BOOTSTRAP_PASSWORD=set_only_for_initial_admin_setup
NEXT_PUBLIC_APP_URL=https://noidi.9phut.org
PASSKEY_RP_ID=noidi.9phut.org
PASSKEY_ORIGIN=https://noidi.9phut.org
AI_ALLOWED_HOSTS=api.openai.com,9r.9phut.org
