# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/output/

# local browser automation
/.playwright-cli/

# Kotlin/Gradle generated state
/paylingo-mobile/.gradle/
/paylingo-mobile/**/build/
/paylingo-mobile/local.properties

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.wrangler

# local d1/sqlite
.data/
supabase/.temp/
.hallmark/

# typescript
*.tsbuildinfo
next-env.d.ts
